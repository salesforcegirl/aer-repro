<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Legacy_Score_Sanity</fullName>
    <active>true</active>
    <errorConditionFormula>AND(BEGINS(Name, 'LEGACY'), Legacy_Score__c &lt; -1000000, CONTAINS(Legacy_Tier__c, 'Broken'))</errorConditionFormula>
    <errorMessage>Score is out of range.</errorMessage>
</ValidationRule>
