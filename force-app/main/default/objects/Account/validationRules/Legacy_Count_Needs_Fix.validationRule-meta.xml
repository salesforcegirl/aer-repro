<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Legacy_Count_Needs_Fix</fullName>
    <active>true</active>
    <errorConditionFormula>AND(BEGINS(Name, 'LEGACY'), ISCHANGED(Legacy_Contact_Count__c), NOT(Legacy_Fixed__c))</errorConditionFormula>
    <errorMessage>Contact count changed before the account was fixed.</errorMessage>
</ValidationRule>
