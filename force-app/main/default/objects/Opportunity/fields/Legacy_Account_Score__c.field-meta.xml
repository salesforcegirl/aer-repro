<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Legacy_Account_Score__c</fullName>
    <label>Legacy Account Score</label>
    <formula>Account.Legacy_Score__c * IF(ISBLANK(Amount), 1, Amount / 1000)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>18</precision>
    <scale>2</scale>
    <type>Number</type>
</CustomField>
