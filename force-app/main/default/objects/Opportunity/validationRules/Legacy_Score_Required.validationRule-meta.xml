<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Legacy_Score_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(BEGINS(Account.Name, 'LEGACY'), Legacy_Account_Score__c &lt; 0)</errorConditionFormula>
    <errorMessage>Account score cannot be negative.</errorMessage>
</ValidationRule>
