<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Legacy_Tier_Not_Broken</fullName>
    <active>true</active>
    <errorConditionFormula>AND(BEGINS(Account.Name, 'LEGACY'), CONTAINS(Legacy_Account_Tier__c, 'Broken'))</errorConditionFormula>
    <errorMessage>Account tier is broken.</errorMessage>
</ValidationRule>
